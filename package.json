{
  "name": "pwa-nexus",
  "version": "0.1.11",
  "description": "Offline Android PWA template: plain HTML, CSS and ES modules, no build step",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#ds/*": "./vendor/design-system/*.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs",
    "init": "node scripts/init.mjs",
    "ds": "node ../pwa-design-system/sync.mjs"
  }
}
